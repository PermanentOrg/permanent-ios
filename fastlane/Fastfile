# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Description of what the lane does"
  
  lane :tests do
    setup_ci

    # add actions here: https://docs.fastlane.tools/actions
    cocoapods(use_bundle_exec: true,
              podfile: "./Podfile")
    run_tests(workspace: "Permanent.xcworkspace",
              devices: ["iPhone 17 Pro"],
              scheme: "Permanent-DEV",
	            configuration: "DEV-Debug",
              testplan: "#{ENV['TEST_PLAN']}",
	            reset_simulator: true)
  end

  lane :cocopods do
    # resolve cocoapods
    cocoapods(use_bundle_exec: true,
              podfile: "./Podfile")
  end

  lane :beta do
    setup_ci

    # resolve cocoapods
    cocoapods(use_bundle_exec: true,
              podfile: "./Podfile")
              
    # connect to the app store
    app_store_connect_api_key(duration: 1200, # optional (maximum 1200)
                              in_house: false,
                              is_key_content_base64: false
                              )
   
    # resolve the provisioning profiles and certs from private repo
    match(type: "adhoc",
          app_identifier: "org.permanent.permanent.staging",
          git_url: "https://oauth2:#{ENV['FASTLANE_MATCH_TOKEN']}@github.com/PermanentOrg/permanent-ios-certs.git",
          force_for_new_devices: true,
          verbose: true
          )
    match(type: "adhoc",
          app_identifier: "org.permanent.permanent.staging.PushExtension",
          git_url: "https://oauth2:#{ENV['FASTLANE_MATCH_TOKEN']}@github.com/PermanentOrg/permanent-ios-certs.git",
          force_for_new_devices: true
          )
    match(type: "adhoc",
          app_identifier: "org.permanent.permanent.staging.ShareExtension",
          git_url: "https://oauth2:#{ENV['FASTLANE_MATCH_TOKEN']}@github.com/PermanentOrg/permanent-ios-certs.git",
          force_for_new_devices: true
          )

    # get the latest release build # from firebase
    begin
      latest_release = firebase_app_distribution_get_latest_release(
        app: ENV['FIREBASEAPPDISTRO_APP'],
        service_credentials_json_data: ENV['FIREBASE_SERVICE_ACCOUNT_KEY']
      )
      if latest_release
        # update the app build number
        increment_build_number({ build_number: latest_release[:buildVersion].to_i + 1 })
      end
    rescue => e
      UI.important("⚠️  Could not fetch latest release: #{e.message}. Continuing with current build number.")
    end

    # actually build the app
    build_app(scheme: "Permanent-DEV",
	            configuration: "DEV-Release",
	            xcargs: "-allowProvisioningUpdates",
              include_bitcode: false,
              export_method: "ad-hoc",
              skip_codesigning: true,
              clean: true,
              export_team_id: "C8YKZNBVWT")

    # get the change log - all the commits since the last tag in git
    changelog = changelog_from_git_commits(merge_commit_filtering: 'exclude_merges')

    # upload to firebase
	firebase_app_distribution(
      app: ENV['FIREBASEAPPDISTRO_APP'],
      release_notes: changelog,
      service_credentials_json_data: ENV['FIREBASE_SERVICE_ACCOUNT_KEY']
    )
  end
  
  lane :app_store do 
    setup_ci

    # resolve cocoapods
    cocoapods(use_bundle_exec: true,
              podfile: "./Podfile")
           
    # connect to the app store
    app_store_connect_api_key(duration: 1200, # optional (maximum 1200)
                              in_house: false,
                              is_key_content_base64: false
                              )

    # resolve the provisioning profiles and certs from private repo
    match(type: "appstore",
          readonly: true,
          platform: "ios",
          app_identifier: "org.permanent.PermanentArchive",
          git_url: "https://oauth2:#{ENV['FASTLANE_MATCH_TOKEN']}@github.com/PermanentOrg/permanent-ios-certs.git",
          keychain_password: ""
          )
    match(type: "appstore",
          readonly: true,
          platform: "ios",
          app_identifier: "org.permanent.PermanentArchive.PushExtension",
          git_url: "https://oauth2:#{ENV['FASTLANE_MATCH_TOKEN']}@github.com/PermanentOrg/permanent-ios-certs.git",
          keychain_password: ""
          )
    match(type: "appstore",
          readonly: true,
          platform: "ios",
          app_identifier: "org.permanent.PermanentArchive.ShareExtension",
          git_url: "https://oauth2:#{ENV['FASTLANE_MATCH_TOKEN']}@github.com/PermanentOrg/permanent-ios-certs.git",
          keychain_password: ""
          )
    match(type: "appstore",
          readonly: true,
          platform: "ios",
          app_identifier: "org.permanent.PermanentArchive.Widgets",
          git_url: "https://oauth2:#{ENV['FASTLANE_MATCH_TOKEN']}@github.com/PermanentOrg/permanent-ios-certs.git",
          keychain_password: ""
          )

    # get the latest release build # from firebase
    latest_release = latest_testflight_build_number(app_identifier: "org.permanent.PermanentArchive")
    if latest_release
      # update the app build number
      increment_build_number({ build_number: latest_release + 1 })
    end
    
    # match suffixes a profile's name when the canonical one is taken, so never hardcode names
    profile_mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]

    update_code_signing_settings(
        targets: ["Permanent"],
        use_automatic_signing: false,
        path: "Permanent.xcodeproj",
        profile_name: profile_mapping["org.permanent.PermanentArchive"],
        code_sign_identity: "Apple Distribution"
    )

    update_code_signing_settings(
        targets: ["PushExtension"],
        use_automatic_signing: false,
        path: "Permanent.xcodeproj",
        profile_name: profile_mapping["org.permanent.PermanentArchive.PushExtension"],
        code_sign_identity: "Apple Distribution"
    )

    update_code_signing_settings(
        targets: ["ShareExtension"],
        use_automatic_signing: false,
        path: "Permanent.xcodeproj",
        profile_name: profile_mapping["org.permanent.PermanentArchive.ShareExtension"],
        code_sign_identity: "Apple Distribution"
    )

    update_code_signing_settings(
        targets: ["PermanentWidgetsExtension"],
        use_automatic_signing: false,
        path: "Permanent.xcodeproj",
        profile_name: profile_mapping["org.permanent.PermanentArchive.Widgets"],
        code_sign_identity: "Apple Distribution"
    )

     # actually build the app
    build_app(workspace: "Permanent.xcworkspace",
              scheme: "Permanent",
	            configuration: "Release",
              include_bitcode: false,
              clean: true,
              export_options: {
                  method: "app-store"
              }
      )

    # "What to Test" for testers, rewritten per release; the last commit is only a safety net
    notes_path = ["fastlane/WhatToTest.txt", "WhatToTest.txt"].find { |path| File.exist?(path) }
    test_notes = notes_path ? File.read(notes_path).strip : ""
    test_notes = last_git_commit[:message] if test_notes.empty?

    #upload to TestFlight
    upload_to_testflight(app_identifier: "org.permanent.PermanentArchive",
                         changelog: test_notes.to_s[0, 4000])
  end

  lane :update_devices do     
    # connect to the app store
    app_store_connect_api_key(key_id: ENV['APP_STORE_CONNECT_API_KEY_KEY_ID'],
      issuer_id: ENV['APP_STORE_CONNECT_API_KEY_ISSUER_ID'],
      key_content: ENV['APP_STORE_CONNECT_API_KEY_KEY']
      )

    # resolve the provisioning profiles and certs from private repo
    match(type: "adhoc",
          readonly: false,
          platform: "ios",
          app_identifier: "org.permanent.permanent.staging",
          git_url: "https://oauth2:#{ENV['FASTLANE_MATCH_TOKEN']}@github.com/PermanentOrg/permanent-ios-certs.git",
          force_for_new_devices: true,
          force: true,
          verbose: true
          )
    match(type: "adhoc",
          readonly: false,
          platform: "ios",
          app_identifier: "org.permanent.permanent.staging.PushExtension",
          git_url: "https://oauth2:#{ENV['FASTLANE_MATCH_TOKEN']}@github.com/PermanentOrg/permanent-ios-certs.git",
          force_for_new_devices: true,
          force: true
          )
    match(type: "adhoc",
          readonly: false,
          platform: "ios",
          app_identifier: "org.permanent.permanent.staging.ShareExtension",
          git_url: "https://oauth2:#{ENV['FASTLANE_MATCH_TOKEN']}@github.com/PermanentOrg/permanent-ios-certs.git",
          force_for_new_devices: true,
          force: true
          )

    # regenerate the App Store profiles so they always embed the current manual distribution cert
    match(type: "appstore",
          readonly: false,
          platform: "ios",
          app_identifier: "org.permanent.PermanentArchive",
          git_url: "https://oauth2:#{ENV['FASTLANE_MATCH_TOKEN']}@github.com/PermanentOrg/permanent-ios-certs.git",
          force: true
          )
    match(type: "appstore",
          readonly: false,
          platform: "ios",
          app_identifier: "org.permanent.PermanentArchive.PushExtension",
          git_url: "https://oauth2:#{ENV['FASTLANE_MATCH_TOKEN']}@github.com/PermanentOrg/permanent-ios-certs.git",
          force: true
          )
    match(type: "appstore",
          readonly: false,
          platform: "ios",
          app_identifier: "org.permanent.PermanentArchive.ShareExtension",
          git_url: "https://oauth2:#{ENV['FASTLANE_MATCH_TOKEN']}@github.com/PermanentOrg/permanent-ios-certs.git",
          force: true
          )
    match(type: "appstore",
          readonly: false,
          platform: "ios",
          app_identifier: "org.permanent.PermanentArchive.Widgets",
          git_url: "https://oauth2:#{ENV['FASTLANE_MATCH_TOKEN']}@github.com/PermanentOrg/permanent-ios-certs.git",
          force: true
          )
  end

end
